FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY src ./src
ENV HOST=0.0.0.0 PORT=8787 ARENA_MAX_ROOMS=1 ARENA_DATA_DIR=/data
EXPOSE 8787
RUN mkdir /data && chown node:node /data
USER node
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm","run","arena:server"]
